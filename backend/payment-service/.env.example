# Application
APP_NAME=payment-service
DEBUG=false
LOG_LEVEL=INFO

# Server
HOST=0.0.0.0
PORT=8084

# Database
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5435/payment_db
DATABASE_POOL_SIZE=10
DATABASE_MAX_OVERFLOW=20

# Kafka
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
KAFKA_ENABLED=true

# Payment Gateway
GATEWAY_SUCCESS_RATE=0.9
GATEWAY_PROCESSING_TIME_MS=1000
