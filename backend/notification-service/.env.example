# Application
APP_NAME=notification-service
DEBUG=false

# Database
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5436/notification_db
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_ECHO=false

# Kafka
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
KAFKA_CONSUMER_GROUP_ID=notification-service
KAFKA_AUTO_OFFSET_RESET=earliest
KAFKA_ENABLE_AUTO_COMMIT=true
KAFKA_MAX_POLL_RECORDS=10

# Kafka Topics
KAFKA_TOPIC_BOOKING_CONFIRMED=booking.confirmed
KAFKA_TOPIC_BOOKING_CANCELLED=booking.cancelled
KAFKA_TOPIC_PAYMENT_SUCCESS=payment.success
KAFKA_TOPIC_PAYMENT_FAILED=payment.failed

# Email Configuration
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_USE_TLS=false
SMTP_FROM_EMAIL=noreply@bookmyshow.com
SMTP_FROM_NAME=BookMyShow

# SMS Configuration
SMS_ENABLED=true
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=+1234567890

# Logging
LOG_LEVEL=INFO
