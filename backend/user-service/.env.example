# Application Configuration
APP_NAME=User Service
APP_VERSION=0.1.0
DEBUG=false

# Server Configuration
HOST=0.0.0.0
PORT=8080

# Database Configuration
DATABASE_URL=postgresql+asyncpg://postgres:postgres@postgres:5432/user_service

# Redis Configuration
REDIS_URL=redis://redis:6379/0

# JWT Configuration
JWT_SECRET=bookmyshow-secret-key-for-jwt-token-generation-and-validation-must-be-at-least-256-bits
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRATION=3600000
REFRESH_TOKEN_EXPIRATION=86400000

# CORS Configuration
CORS_ORIGINS=*

# Logging Configuration
LOG_LEVEL=INFO
